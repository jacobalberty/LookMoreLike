    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.14.0",
    "eslint-plugin-vue": "10.12.1",
    "globals": "17.14.0",
    "happy-dom": "21.0.4",
    "typescript": "5.9.3",
